# Discord — bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Optional: register commands to one guild for instant updates while testing
DISCORD_GUILD_ID=
# Reply to @mentions with the AI (requires the privileged Message Content intent)
ENABLE_MENTION_CHAT=false
# Channels (names or IDs, comma-separated) where the bot replies to EVERY message
# CHAT_CHANNELS=mrroboto

# AI provider: "anthropic" (default), "openai", or "claude-code"
# claude-code routes chat through the local Claude Code CLI login (subscription,
# no API key) with tools disabled. Requires an authenticated `claude` CLI.
AI_PROVIDER=anthropic
# CLAUDE_CODE_MODEL=default
# claude-code capability mode: chat (no tools, default) | readonly (skills +
# read-only tools) | full (skills + all tools auto-approved - trusted servers only!)
# CLAUDE_CODE_MODE=chat

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Wise knowledge server (optional) — /ask retrieves from this MCP corpus first,
# falling back to the local LanceDB store
# KNOWLEDGE_MCP_URL=https://knowledge.example.net/api/mcp
# KNOWLEDGE_MCP_KEY=
# Docmost wiki base URL for /docs result links
# DOCMOST_URL=

# Google Drive corpus source (optional — local ./corpus always works)
# Service account with read access to the folder; keep \n escapes in the key.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional tuning
# SYSTEM_PROMPT=You are Carbon, a helpful Discord bot.
# HISTORY_LIMIT=20
# HEALTH_PORT=8300
# EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# DATA_DIR=./data
# CORPUS_DIR=./corpus
# YOLO_MODEL_PATH=./models/yolo26s.onnx

# Free-text appended to dev/full-mode system prompts (mounted shares, conventions)
# EXTRA_CONTEXT=
# Repo root for channel-per-repo dev sessions
# REPO_ROOT=/work/wisejnrs-projects

# Social posting via /post (see SETUP-social.md)
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=

# Personal WhatsApp bridge (Baileys, unofficial protocol - QR link; ban risk is yours)
# WHATSAPP=true
# WHATSAPP_CHANNEL=whatsapp

# --- Microsoft 365 WORK tools (optional; Azure AD app, client-credentials flow) ---
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
# WORK_EMAIL=you@example.com

# --- Owner override list (comma-separated Discord user IDs) ---
# Owners bypass the dev-session command guard; everyone else is blocked from a
# small set of destructive commands (sudo, dd, mkfs, rm -rf /, curl|sh, ...).
# OWNER_USER_IDS=

# --- Voice (OpenAI STT/TTS + optional Hume Octave TTS) ---
# STT_MODEL=gpt-4o-transcribe
# TTS_MODEL=gpt-4o-mini-tts
# HUME_API_KEY=
# HUME_VOICE_NAME=
# HUME_VOICE_PROVIDER=HUME_AI          # CUSTOM_VOICE for cloned/saved voices
# VOICE_CONV_WINDOW_MS=20000           # follow-up window after the wake word
# VOICE_AUTOJOIN_USER_ID=              # auto-join this user's voice channel
