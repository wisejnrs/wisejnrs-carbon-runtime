{
  "name": "carbon-bot",
  "version": "1.0.0",
  "description": "Carbon Discord bot - TypeScript rewrite of Carbon.Bot (.NET) with Claude/OpenAI support",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "shakedown": "node dist/shakedown.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.202",
    "@anthropic-ai/sdk": "^0.110.0",
    "@discordjs/voice": "^0.19.2",
    "@huggingface/transformers": "^4.2.0",
    "@lancedb/lancedb": "^0.31.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "googleapis": "^173.0.0",
    "hume": "^0.16.0",
    "inngest": "^4.12.1",
    "libsodium-wrappers": "^0.7.16",
    "onnxruntime-node": "1.24.3",
    "openai": "^6.45.0",
    "opusscript": "^0.0.8",
    "pino": "^10.3.1",
    "prism-media": "^1.3.5",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
